# Copy to .env (gitignored) for local Supabase CLI use, and set the same names in
# production with:  supabase secrets set --env-file .env
# NEVER put any of these in assets/js/config.js or any browser file.

# Midtrans server key (sandbox keys start with "SB-Mid-server-")
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
# "true" only after explicit authorization to take real payments
MIDTRANS_IS_PRODUCTION=false

# Public site URL (Midtrans returns here; used for redirects)
SITE_URL=https://your-site.pages.dev
# Comma-separated browser origins allowed to call the Edge Functions
ALLOWED_ORIGINS=https://your-site.pages.dev,http://localhost:8080

# --- Only for scripts/bootstrap-admin.ts on a trusted machine (not a function secret) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# ADMIN_EMAIL=you@example.com

# Supabase injects SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEYS
# (and legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY) into Edge Functions
# automatically; you do not set those yourself.

# Optional: advertiser emails (campaign approved / payment due / rejected) via https://resend.com.
# Without these two secrets the emails are simply not sent. Set them with `supabase secrets set`.
# RESEND_API_KEY=re_REPLACE_ME
# EMAIL_FROM=Campus Sticky Wall <hello@your-domain.example>
